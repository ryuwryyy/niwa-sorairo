{
  "name": "teire",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "手入れ — 名前を知り、季節を待ち、手を入れる。庭仕事の記録帳。",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "worker:dev": "wrangler dev worker/index.js",
    "worker:deploy": "wrangler deploy worker/index.js",
    "build:research": "vite build --config vite.research.config.js",
    "dev:research": "vite --config vite.research.config.js --port 5174",
    "test": "node --test 'tests/*.test.js'",
    "check": "npm test && npm run build && npm run build:research && node --check figma-plugin/code.js",
    "e2e": "node tests/e2e/run.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1"
  }
}
