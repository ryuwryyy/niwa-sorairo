# このファイルを .env.local としてコピーし、自分のキーを設定する。
# .env.local は .gitignore 済み — 絶対にコミットしないこと。
#
# 【APIキーの置き場所】
# - ローカル開発: このファイル（.env.local）
# - 本番(Vercel): ダッシュボード → Project → Settings → Environment Variables（Production）
# - 絶対に VITE_ を付けない（付けるとブラウザに露出する）
# - フロントのコードや vercel.json にキーを書かない

# ---- 手入れ（庭）: 名前判定・添え書き ----
ANTHROPIC_API_KEY=ここに自分のAPIキーを貼る

# Jevリサーチ(/research/)用。TypeSafe AI のダッシュボードで発行したキー。
# ANTHROPIC_API_KEY と同じく VITE_ は付けない。未設定でも「デモ判定」で画面は試せる
TYPESAFE_API_KEY=ここにTypeSafeのAPIキーを貼る

# 深掘りレポートの「Braveで集める」用。https://api-dashboard.search.brave.com で発行(毎月5ドル分の無料クレジット ≒ 約1000クエリ)
# 空色 Studio の画像検索（Pinterest 全体・カンヌ作品の代替、site:pinterest.com で絞る）も同じキーを使う
BRAVE_API_KEY=ここにBraveのAPIキーを貼る

# ---- 空色 Studio (/studio/) ----
# 課題設定・原理抽出・プロンプト磨き・批評・Figma spec（Claude）
# ANTHROPIC_API_KEY を共用。モデルは既定 claude-opus-5（変更する場合のみ）
STUDIO_CLAUDE_MODEL=claude-opus-5

# 画像生成（Google AI Studio → Get API key）。既定モデルは gemini-2.5-flash-image（Nano Banana）
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Pinterest 公式 API v5（任意）。注意: /v5/search/pins は「トークン所有者自身のピン」だけを検索する
#   （Pinterest 全体の公開検索は一般アプリには提供されていない）。チームの Pinterest アカウントの
#   ボードを検索する用途に使う。scopes: pins:read boards:read
PINTEREST_ACCESS_TOKEN=

# Brave Search の画像検索は上の BRAVE_API_KEY を共用する。Studio だけ別のキーにしたい場合のみ設定
BRAVE_SEARCH_API_KEY=

# Google Programmable Search（任意・レガシー）。Custom Search JSON API は 2027-01-01 に終了予定で
#   新規申込は受け付けていない。既にキーを持っている場合のみ設定する（cx は pinterest.com 等を指定した検索エンジン）
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# Adobe Stock Search API（任意。Adobe Developer Console → Adobe Stock API → API key。検索はキーだけで動く）
#   注意: Adobe の開発者規約により Stock 素材とメタデータの AI/ML 利用は禁止 → アプリでは「表示・参考のみ」
ADOBE_STOCK_API_KEY=
ADOBE_STOCK_PRODUCT=SorairoStudio/1.0
